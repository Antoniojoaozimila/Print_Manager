NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=mysql://root:root@localhost:3306/print_manager

# Alternativa (se não usar DATABASE_URL): descomente e preencha
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=print_manager
# DB_USER=root
# DB_PASSWORD=root

JWT_SECRET=altere_para_um_segredo_longo_e_aleatorio
JWT_EXPIRES_IN=8h

# Preço por página (moeda local) para estimativa de custo
PRECO_PAGINA_PB=0.02
PRECO_PAGINA_COLOR=0.08
PRECO_PAGINA_DUPLEX_DESCONTO=0.1

# Backup automático (caminho absoluto da pasta; requer mysqldump no PATH)
BACKUP_DIR=./storage/backups
BACKUP_CRON=0 2 * * *

# Varredura LAN (POST /impressoras/descoberta-rede): 1 = desativar; limite de IPs por pedido
# DISABLE_NETWORK_DISCOVERY=0
# DISCOVERY_MAX_HOSTS=254

# Logótipo Imperial para relatórios (PNG/JPEG). Por omissão: backend/assets/branding/imperial-logo.png
# IMPERIAL_LOGO_PATH=C:/caminho/para/imperial-logo.png
# URL alternativa se não houver ficheiro local:
# IMPERIAL_LOGO_URL=https://...

# Gestão escritório / PaperCut — custos estimados em relatórios (MZN)
# PRECO_FOLHA_MZN=0.15
# PRECO_TONER_ESTIMADO_MZN=5000
# TONER_FACTOR_COLOR=0.012
# TONER_FACTOR_GRAY=0.0015
# TONER_FACTOR_DUPLEX_BONUS=0.0003
# ALERTA_STOCK_CAIXAS_A4=2
# ALERTA_CONSUMO_EXCESSO_MULT=2.5
